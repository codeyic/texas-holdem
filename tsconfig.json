{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./shared/*"],
      "@shared/protocol": ["./shared/protocol.ts"]
    }
  },
  "include": ["server", "shared", "client/src", "vite.config.ts", "vitest.config.ts"]
}
